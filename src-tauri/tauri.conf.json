{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tetris",
  "version": "1.0.0",
  "identifier": "dev.tetris.game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tetris",
        "width": 900,
        "height": 720,
        "minWidth": 480,
        "minHeight": 440,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0b0a14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:5173 ws://localhost:5173; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "shortDescription": "Unofficial Tetris-inspired arcade game",
    "longDescription": "Tetris is an unofficial clone inspired by the original game. It is not affiliated with or endorsed by its rights holders.",
    "copyright": "Copyright (c) 2026 Tetris Contributors",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../dist/assets/music.ogg"],
    "externalBin": [],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {}
}
