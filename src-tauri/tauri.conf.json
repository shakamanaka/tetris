{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tetrix",
  "version": "1.0.0",
  "identifier": "dev.tetrix.game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tetrix",
        "width": 900,
        "height": 720,
        "minWidth": 480,
        "minHeight": 440,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0b0a14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "shortDescription": "Classic block-stacking arcade game",
    "longDescription": "Tetrix is a classic block-stacking arcade game built with Tauri and TypeScript.",
    "copyright": "Copyright (c) 2026 Tetrix Contributors",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../dist/assets/music.ogg"],
    "externalBin": [],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {}
}