{
  "name": "tetris",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "version": "1.0.0",
  "author": "Tetris Contributors",
  "license": "MIT",
  "type": "module",
  "description": "Unofficial Tetris-inspired block-stacking desktop game built with Tauri + TypeScript",
  "keywords": [
    "tetris",
    "tauri",
    "typescript",
    "desktop-game"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"tests/**/*.ts\" \"*.{md,json,yml,yaml,js,ts}\" \"docs/**/*.md\" \".github/**/*.{md,yml,yaml}\" \"src-tauri/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"tests/**/*.ts\" \"*.{md,json,yml,yaml,js,ts}\" \"docs/**/*.md\" \".github/**/*.{md,yml,yaml}\" \"src-tauri/**/*.json\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
